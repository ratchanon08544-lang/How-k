RunService.Heartbeat:Connect(function()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.SeatPart then 
            lastVehicle = LocalPlayer.Character.Humanoid.SeatPart.Parent 
        end

        if autoAttackEnabled and lastVehicle and lastVehicle.PrimaryPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = LocalPlayer.Character.HumanoidRootPart
            local closestPlayer = nil
            local shortestDistance = attackRadius

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local pRoot = p.Character.HumanoidRootPart
                    local dist = (myRoot.Position - pRoot.Position).Magnitude
                    if dist < shortestDistance then shortestDistance = dist; closestPlayer = p end
                end
            end

            if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("LeftUpperLeg") then
                local targetPart = closestPlayer.Character.LeftUpperLeg
                if autoAttackMode == "Default Orbit" then
                    local centerPos = (targetPart.CFrame * CFrame.new(0, math.sin(tick() * 15) * 4, forwardOffset)) 
                    local rotation = CFrame.Angles(math.rad(tick() * 360), math.rad(tick() * 360), 0) 
                    lastVehicle:SetPrimaryPartCFrame(centerPos * rotation)
                else
                    local time = tick() * (spinSpeed / 5)
                    local x = math.cos(time) * targetDistance
                    local z = math.sin(time) * targetDistance
                    local orbitPos = targetPart.CFrame * CFrame.new(x, 0, z)
                    lastVehicle:SetPrimaryPartCFrame(CFrame.new(orbitPos.Position, targetPart.Position))
                end
                for _, p in pairs(lastVehicle:GetDescendants()) do if p:IsA("BasePart") then p.CanTouch = false end end
            else
                local dipRotation = CFrame.Angles(math.rad(-90), math.rad(tick() * 180), 0) 
                local coverPos = myRoot.CFrame * CFrame.new(0, 0, forwardOffset) 
                lastVehicle:SetPrimaryPartCFrame(coverPos * dipRotation)
            end
        end

        if isManualSpinning and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(manualSpinSpeed), 0) 
        end
        
        if spectateEnabled and selectedPlayerName then
            local target = Players:FindFirstChild(selectedPlayerName)
            if target and target.Character and target.Character:FindFirstChild("Humanoid") then Camera.CameraSubject = target.Character.Humanoid end
        end
        
        if noclipEnabled and lastVehicle then 
            for _, p in pairs(lastVehicle:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end 
        end
        
        if isSpinning and selectedPlayerName and lastVehicle and lastVehicle.PrimaryPart then
            local target = Players:FindFirstChild(selectedPlayerName)
            if target and target.Character and target.Character:FindFirstChild("LeftUpperLeg") then
                local targetPart = target.Character.LeftUpperLeg
                if crashMode == "Spin" then
                    local centerPos = (targetPart.CFrame * CFrame.new(0, heightOffset, targetDistance))
                    local wobble = CFrame.new(math.sin(tick() * spinSpeed) * 2, 0, math.cos(tick() * spinSpeed) * 2)
                    local rotation = CFrame.Angles(0, tick() * (spinSpeed / 2), 0)
                    lastVehicle:SetPrimaryPartCFrame(centerPos * wobble * rotation)
                elseif crashMode == "Crash" then
                    local frontPos = (targetPart.CFrame * CFrame.new(0, heightOffset, targetDistance))
                    local lookAtTarget = CFrame.new(frontPos.Position, targetPart.Position)
                    local shake = CFrame.new(math.sin(tick() * spinSpeed) * 0.5, 0, 0)
                    lastVehicle:SetPrimaryPartCFrame(lookAtTarget * shake)
                elseif crashMode == "Clockwise Lock" then
                    local orbitPos = (targetPart.CFrame * CFrame.Angles(0, math.rad(tick() * spinSpeed * 2), 0)) * CFrame.new(0, heightOffset, targetDistance)
                    lastVehicle:SetPrimaryPartCFrame(CFrame.new(orbitPos.Position, targetPart.Position))
                end
                for _, p in pairs(lastVehicle:GetDescendants()) do if p:IsA("BasePart") then p.CanTouch = false end end
            end
        end
    end)
end)
