local function updateVisualCircle()
    if autoAttackEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        if not visualCircle or visualCircle.Parent == nil then
            visualCircle = Instance.new("CylinderHandleAdornment")
            visualCircle.Name = "AutoAttackRangeCircle"
            visualCircle.Color3 = Color3.fromRGB(0, 162, 255)
            visualCircle.Transparency = 0.7
            visualCircle.AlwaysOnTop = true
            visualCircle.ZIndex = 5
            visualCircle.Angle = 360
        end
        visualCircle.Adornee = LocalPlayer.Character.HumanoidRootPart
        visualCircle.Radius = attackRadius
        visualCircle.Height = 0.5
        visualCircle.CFrame = CFrame.new(0, -3, 0) * CFrame.Angles(math.rad(90), 0, 0)
        visualCircle.Parent = LocalPlayer.Character.HumanoidRootPart
    else
        if visualCircle then
            visualCircle:Destroy()
            visualCircle = nil
        end
    end
end

