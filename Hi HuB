-- ==========================================
-- ระบบมองผู้เล่นคนอื่น (ESP RGB ขนาดกะทัดรัด - ลบปุ่มตาออกแล้ว)
-- ==========================================
local function createEspForPlayer(targetPlayer)
	if targetPlayer == player then return end
	
	local function onCharacterAdded(char)
		local head = char:WaitForChild("Head", 5)
		if not head then return end
		
		local bbGui = Instance.new("BillboardGui")
		bbGui.Name = "PlayerEspUI"
		bbGui.Size = UDim2.new(0, 100, 0, 32)
		bbGui.AlwaysOnTop = true
		bbGui.ExtentsOffset = Vector3.new(0, 2.5, 0)
		bbGui.SizeOffset = Vector2.new(0, 0)
		bbGui.Parent = head
		
		local mainFrame = Instance.new("Frame", bbGui)
		mainFrame.Size = UDim2.new(1, 0, 1, 0)
		mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		mainFrame.BackgroundTransparency = 0.1
		Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 6)
		
		local frameStroke = Instance.new("UIStroke", mainFrame)
		frameStroke.Thickness = 1.5
		frameStroke.Color = Color3.fromHSV(0, 1, 1)
		
		local pfpImage = Instance.new("ImageLabel", mainFrame)
		pfpImage.Size = UDim2.new(0, 24, 0, 24)
		pfpImage.Position = UDim2.new(0.08, 0, 0.5, -12)
		pfpImage.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		pfpImage.Image = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		Instance.new("UICorner", pfpImage).CornerRadius = UDim.new(0.5, 0)
		
		local nameLabel = Instance.new("TextLabel", mainFrame)
		nameLabel.Size = UDim2.new(0, 60, 0, 24)
		nameLabel.Position = UDim2.new(0.38, 0, 0.5, -12)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = targetPlayer.DisplayName
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 10
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left

		-- ตัวครอบเรืองแสงรอบตัวละคร (RGB Chams)
		local highlight = Instance.new("Highlight")
		highlight.Name = "PlayerEspHighlight"
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = char
		
		local rgbConnection
		rgbConnection = RunService.RenderStepped:Connect(function()
			if not char:IsDescendantOf(workspace) then rgbConnection:Disconnect(); return end
			local hue = (tick() % 4) / 4
			local color = Color3.fromHSV(hue, 1, 1)
			
			frameStroke.Color = color
			nameLabel.TextColor3 = color
			highlight.FillColor = color
			highlight.OutlineColor = color
		end)
		table.insert(espConnections, rgbConnection)
	end
	
	if targetPlayer.Character then onCharacterAdded(targetPlayer.Character) end
	local charConn = targetPlayer.CharacterAdded:Connect(onCharacterAdded)
	table.insert(espConnections, charConn)
end

local function removeAllEsp()
	for _, conn in pairs(espConnections) do conn:Disconnect() end
	espConnections = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then
			local head = p.Character:FindFirstChild("Head")
			if head and head:FindFirstChild("PlayerEspUI") then head.PlayerEspUI:Destroy() end
			if p.Character:FindFirstChild("PlayerEspHighlight") then p.Character.PlayerEspHighlight:Destroy() end
		end
	end
end

-- ==========================================
-- ลอจิกปุ่มกดเมนูต่างๆ
-- ==========================================

toggleBtn.MouseButton1Click:Connect(function()
	isFreecam = not isFreecam
	camera.CameraType = isFreecam and Enum.CameraType.Scriptable or Enum.CameraType.Custom
	toggleBtn.Text = isFreecam and "ปิด Freecam" or "เปิด Freecam"
	btnW.Visible = isFreecam; btnS.Visible = isFreecam; btnA.Visible = isFreecam; btnD.Visible = isFreecam
	
	if isFreecam then
		local x, y, z = camera.CFrame:ToOrientation()
		cameraYaw, cameraPitch = math.deg(y), math.clamp(math.deg(x), -80, 80)
		toggleStroke.Color = Color3.fromRGB(200, 50, 50)
		if player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.WalkSpeed = 0 end
	else
		toggleStroke.Color = Color3.fromRGB(80, 80, 80)
		if player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.WalkSpeed = 16 end
		for k in pairs(movement) do movement[k] = false end
	end
end)

lightBtn.MouseButton1Click:Connect(function()
	isBrightMode = not isBrightMode
	Lighting.Brightness = isBrightMode and 4 or 2
	Lighting.GlobalShadows = not isBrightMode
	Lighting.FogStart = isBrightMode and 999999 or 0
	Lighting.FogEnd = isBrightMode and 999999 or 100000
	Lighting.Ambient = isBrightMode and Color3.fromRGB(255,255,255) or Color3.fromRGB(128,128,128)
	Lighting.OutdoorAmbient = isBrightMode and Color3.fromRGB(255,255,255) or Color3.fromRGB(128,128,128)
	lightBtn.Text = isBrightMode and "ปิดโหมดเพิ่มแสง" or "เปิดโหมดเพิ่มแสง"
	lightStroke.Color = isBrightMode and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(80, 80, 80)
end)

espBtn.MouseButton1Click:Connect(function()
	isEspActive = not isEspActive
	espBtn.Text = isEspActive and "ปิดระบบมองผู้เล่น" or "เปิดระบบมองผู้เล่น"
	if isEspActive then
		espStroke.Color = Color3.fromRGB(180, 50, 200)
		for _, p in pairs(Players:GetPlayers()) do createEspForPlayer(p) end
		local joinConn = Players.PlayerAdded:Connect(createEspForPlayer)
		table.insert(espConnections, joinConn)
	else
		espStroke.Color = Color3.fromRGB(80, 80, 80)
		removeAllEsp()
	end
end)

clayBtn.MouseButton1Click:Connect(function()
	isClayMode = not isClayMode
	clayBtn.Text = isClayMode and "ปิดโหมดดินน้ำมัน" or "เปิดโหมดดินน้ำมัน"
	clayStroke.Color = isClayMode and Color3.fromRGB(230, 130, 20) or Color3.fromRGB(80, 80, 80)
	
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			if isClayMode then
				if not obj:GetAttribute("OldMaterial") then obj:SetAttribute("OldMaterial", obj.Material.Value) end
				obj.Material = Enum.Material.Plastic
			else
				local oldMat = obj:GetAttribute("OldMaterial")
				obj.Material = oldMat and Enum.Material[oldMat] or Enum.Material.SmoothPlastic
			end
		end
	end
end)

-- ==========================================
-- ลูปควบคุมทิศทาง Freecam บนจอมือถือ
-- ==========================================
UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
	if not isFreecam or gameProcessed then return end 
	local delta = touch.Delta
	cameraYaw = cameraYaw - (delta.X * SENSITIVITY)
	cameraPitch = math.clamp(cameraPitch - (delta.Y * SENSITIVITY), -80, 80)
end)

RunService.RenderStepped:Connect(function()
	local menuHue = (tick() % 6) / 6
	if not isFreecam then toggleStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8) end
	if not isBrightMode then lightStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8) end
	if not isEspActive then espStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8) end
	if not isClayMode then clayStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8) end
	speedStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8)
	toggleUiStroke.Color = Color3.fromHSV(menuHue, 0.7, 0.8) -- ให้ปุ่มล็อกหน้าจอวิ่งแสง RGB ด้วยเช่นกัน

	if not isFreecam then return end
	
	local rotationCFrame = CFrame.Angles(0, math.rad(cameraYaw), 0) * CFrame.Angles(math.rad(cameraPitch), 0, 0)
	camera.CFrame = CFrame.new(camera.CFrame.Position) * rotationCFrame
	
	local moveDirection = Vector3.new(0, 0, 0)
	if movement.W then moveDirection = moveDirection + camera.CFrame.LookVector end
	if movement.S then moveDirection = moveDirection - camera.CFrame.LookVector end
	if movement.A then moveDirection = moveDirection - camera.CFrame.RightVector end
	if movement.D then moveDirection = moveDirection + camera.CFrame.RightVector end
	
	if moveDirection.Magnitude > 0 then
		camera.CFrame = camera.CFrame + (moveDirection.Unit * CAM_SPEED)
	end
end)
