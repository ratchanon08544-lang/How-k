-- ==================== 4. ปุ่มเริ่มทำงาน ====================
local goButton = Instance.new("TextButton")
goButton.Size = UDim2.new(0, 250, 0, 40)
goButton.Position = UDim2.new(0.5, -125, 0, 174)
goButton.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
goButton.TextColor3 = Color3.fromRGB(255, 255, 255)
goButton.TextSize = 13
goButton.Font = Enum.Font.GothamBold
goButton.Text = "🚀 4. ไปยังจุดที่ปักหมุดทันที"
goButton.Parent = mainFrame

local goCorner = Instance.new("UICorner")
goCorner.CornerRadius = UDim.new(0, 8)
goCorner.Parent = goButton

goButton.MouseButton1Click:Connect(function()
    if isExecuting then
        isExecuting = false
        clearPathVisuals()
        local char = player.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
        end
        goButton.Text = "🚀 4. ไปยังจุดที่ปักหมุดทันที"
        goButton.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
        return
    end
    
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    isExecuting = true
    goButton.Text = "⏹️ หยุดการทำงาน"
    goButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
    
    task.spawn(function()
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local rootPart = char.HumanoidRootPart
        
        while isExecuting do
            while isAntiCheatTriggered() and isExecuting do
                clearPathVisuals()
                goButton.Text = "⚠️ รอคำเตือนหาย..."
                task.wait(1)
            end
            if not isExecuting then break end
            goButton.Text = "⏹️ หยุดการทำงาน"

            humanoid.WalkSpeed = currentSpeed
            local path = PathfindingService:CreatePath({ 
                AgentRadius = 2.5, 
                AgentHeight = 5.0, 
                AgentCanJump = true,
                WaypointSpacing = 4
            })
            
            local success = pcall(function() path:ComputeAsync(rootPart.Position, targetPos) end)
            
            if success and path.Status == Enum.PathStatus.Success then
                local waypoints = path:GetWaypoints()
                drawPathVisuals(waypoints)
                
                for _, wp in ipairs(waypoints) do
                    if not isExecuting then break end
                    
                    while isAntiCheatTriggered() and isExecuting do
                        task.wait(1)
                    end
                    
                    if walkType == "Normal" then
                        local groundY = getGroundHeight(wp.Position)
                        humanoid:MoveTo(Vector3.new(wp.Position.X, groundY + 0.5, wp.Position.Z))
                        if wp.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
                        local startTime = tick()
                        repeat task.wait(0.1) until (rootPart.Position - wp.Position).Magnitude < 3.5 or tick() - startTime > 3 or not isExecuting
                    else
                        -- โหมดขับรถเกาะถนนจริง (แนบพื้น ไม่ลอย ไม่ติด Fly Detected)
                        local carModel, carRoot = getPlayerCarModel()
                        
                        if carModel and carModel.Parent then
                            local startPos = carRoot.Position
                            local groundY = getGroundHeight(wp.Position)
                            local destPos = Vector3.new(wp.Position.X, groundY + 1.2, wp.Position.Z)
                            local dist = (destPos - startPos).Magnitude
                            local duration = dist / currentSpeed
                            local elapsed = 0
                            
                            while elapsed < duration and isExecuting and carModel.Parent do
                                if isAntiCheatTriggered() then break end
                                local dt = task.wait(0.02)
                                elapsed = elapsed + dt
                                local alpha = math.clamp(elapsed / duration, 0, 1)
                                local lerpPos = startPos:Lerp(destPos, alpha)
                                
                                local lookTarget = Vector3.new(destPos.X, lerpPos.Y, destPos.Z)
                                if (lookTarget - lerpPos).Magnitude > 0.1 then
                                    local flatCFrame = CFrame.lookAt(lerpPos, lookTarget)
                                    if carModel.PrimaryPart then
                                        carModel:SetPrimaryPartCFrame(flatCFrame)
                                    else
                                        carRoot.CFrame = flatCFrame
                                    end
                                end
                                
                                for _, part in ipairs(carModel:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    end
                                end
                            end
                        else
                            local startPos = rootPart.Position
                            local groundY = getGroundHeight(wp.Position)
                            local destPos = Vector3.new(wp.Position.X, groundY + 1.5, wp.Position.Z)
                            local dist = (destPos - startPos).Magnitude
                            local duration = dist / currentSpeed
                            local elapsed = 0
                            
                            while elapsed < duration and isExecuting do
                                if isAntiCheatTriggered() then break end
                                local dt = task.wait(0.02)
                                elapsed = elapsed + dt
                                local alpha = math.clamp(elapsed / duration, 0, 1)
                                local lerpPos = startPos:Lerp(destPos, alpha)
                                
                                local lookTarget = Vector3.new(destPos.X, lerpPos.Y, destPos.Z)
                                if (lookTarget - lerpPos).Magnitude > 0.1 then
                                    rootPart.CFrame = CFrame.lookAt(lerpPos, lookTarget)
                                end
                                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
                
                if (rootPart.Position - targetPos).Magnitude < 5 then break end
            else
                local groundY = getGroundHeight(targetPos)
                if walkType == "Normal" then
                    humanoid:MoveTo(Vector3.new(targetPos.X, groundY + 0.5, targetPos.Z))
                else
                    rootPart.CFrame = CFrame.new(targetPos.X, groundY + 1.5, targetPos.Z)
                end
                task.wait(1)
            end
            task.wait(0.2)
        end
        
        isExecuting = false
        clearPathVisuals()
        if char and char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").WalkSpeed = 16 end
        goButton.Text = "🚀 4. ไปยังจุดที่ปักหมุดทันที"
        goButton.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
    end)
end)

