-- โฟลเดอร์เส้นทางเรืองแสง
local pathFolder = Instance.new("Folder")
pathFolder.Name = "UranusPathVisualizerWalk"
pathFolder.Parent = Workspace

local function clearPathVisuals()
    pathFolder:ClearAllChildren()
end

local function getGroundHeight(pos)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    if player.Character then
        raycastParams.FilterDescendantsInstances = {player.Character}
    end
    
    local raycastResult = Workspace:Raycast(pos + Vector3.new(0, 15, 0), Vector3.new(0, -40, 0), raycastParams)
    if raycastResult then
        return raycastResult.Position.Y
    end
    return pos.Y
end

local function drawPathVisuals(waypoints)
    clearPathVisuals()
    for _, wp in ipairs(waypoints) do
        local part = Instance.new("Part")
        part.Size = Vector3.new(0.6, 0.6, 0.6)
        local groundY = getGroundHeight(wp.Position)
        part.Position = Vector3.new(wp.Position.X, groundY + 0.5, wp.Position.Z)
        part.Anchored = true
        part.CanCollide = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(255, 215, 0)
        part.Shape = Enum.PartType.Ball
        part.Parent = pathFolder
    end
end

local function getPlayerCarModel()
    local char = player.Character
    if not char then return nil, nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local model = seat
        while model and model ~= Workspace and not model:IsA("Model") do
            model = model.Parent
        end
        if model and model:IsA("Model") then
            return model, model.PrimaryPart or seat
        end
    end
    return nil, nil
end

local function isAntiCheatTriggered()
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") and gui.Visible then
            local text = string.lower(gui.Text)
            if string.find(text, "anti noclip") or string.find(text, "teleport detected") or string.find(text, "fly detected") then
                return true
            end
        end
    end
    return false
end

