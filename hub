-- ====================================================================
-- ⚡ Function to send data to Discord with separate status formatting
-- ====================================================================
local function sendNotification(title, isAirdrop)
    if not NotificationEnabled and isAirdrop then return end
    
    local jobId = getServerID()
    -- Deep link simulation system to open the app and join the server instantly on mobile (100% working)
    local robloxJoinLink = "https://www.roblox.com/games/start?placeId=" .. tostring(game.PlaceId) .. "&instanceId=" .. jobId
    local colorCode = isAirdrop and 16515840 or 65535
    
    local descriptionText = ""
    local mentionContent = nil

    if isAirdrop then
        -- [Status 2] Real airdrop dropped: Report 5 main details with instant join link
        mentionContent = "@everyone 🚨 **Radar Target Locked! 100% Legit Airdrop Detected!**"
        descriptionText = string.format(
            "🧑‍🦱 **1. Player Name:** `%s`\n" ..
            "🪪 **2. Player ID:** `%d`\n" ..
            "⚠️ **3. Status:** `Airdrop Has Landed`\n" ..
            "📇 **4. Server ID:**\n```%s```\n" ..
            "📱 **5. Quick Join Link:** [Click Here to Join Server](%s)",
            LocalPlayer.Name,
            LocalPlayer.UserId,
            jobId,
            robloxJoinLink
        )
    else
        -- [Status 1] Script started: Short status report that the player has executed the script (no mention)
        descriptionText = string.format(
            "👤 **Script Execution Detected**\n\n" ..
            "🧑‍🦱 **Player Name:** `%s`\n" ..
            "🪪 **Player ID:** `%d`\n" ..
            "⚙️ **Script Status:** Standby, scanning for airdrops...",
            LocalPlayer.Name,
            LocalPlayer.UserId
        )
    end
    
    local data = {
        ["content"] = mentionContent,
        ["embeds"] = {{
            ["title"] = title,
            ["description"] = descriptionText,
            ["color"] = colorCode,
            ["footer"] = {
                ["text"] = "🪐 Uranus HUB • V16 Custom Alert"
            },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    
    local httpRequestFunc = syn and syn.request or http_request or request or fluxus and fluxus.request or http and http.request
    if httpRequestFunc then
        pcall(function()
            httpRequestFunc({
                Url = WebhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = game:GetService("HttpService"):JSONEncode(data)
            })
        end)
    end
end

